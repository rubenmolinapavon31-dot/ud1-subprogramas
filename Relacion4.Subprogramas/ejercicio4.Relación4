Funcion resultado<-multiplicar(n1,n2)
	Definir resultado, eleccion Como Real
	
	Si eleccion= 1 Entonces
		resultado<- n1 * n2
	FinSi
	Si eleccion= 2 Entonces
		resultado<- n3 * n4
	FinSi
	Si eleccion= 3 Entonces
		resultado<- n5 * n6
	FinSi
	
FinFuncion

